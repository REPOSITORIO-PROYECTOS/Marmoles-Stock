# URL del backend (desarrollo). Ejemplos:
# - uvicorn local: http://127.0.0.1:8000
# - Docker (docker-compose): http://127.0.0.1:8020
#
# Si la definís, el cliente llama directo al API (CORS ya permite :5173) y el proxy de Vite
# usa la misma base para /api, /health, /static y /uploads.
# Si la omitís, las peticiones van a /api... en el mismo origen y Vite reenvía a 127.0.0.1:8000.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Opcional: solo el proxy (si el cliente debe seguir en '' pero el API está en otro host/puerto).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8020
