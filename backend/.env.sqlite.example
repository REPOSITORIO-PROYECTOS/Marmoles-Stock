# Desarrollo local con SQLite (sin Docker).
# Uso: copiar estas líneas al archivo backend/.env (reemplazando la URL de Postgres)
# o en PowerShell, desde la carpeta backend:
#   $env:DATABASE_URL = "sqlite:///../dev_inventory_e2e.db"
#
# Ruta relativa: carpeta marmoles/dev_inventory_e2e.db (una carpeta arriba de backend/).

DATABASE_URL=sqlite:///../dev_inventory_e2e.db
