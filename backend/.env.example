# Copiar este archivo a .env (no se sube a Git) y ajustar si hace falta.
#
# Base recomendada: PostgreSQL (mismas credenciales que docker-compose.yml).
# Las migraciones Alembic están pensadas para Postgres; no uses SQLite para init completo.

DATABASE_URL=postgresql+psycopg2://marmoles_user:marmoles_password@127.0.0.1:5432/marmoles_db

# false (default): solo API de inventario + autenticación. true: CRM, presupuestos, finanzas, logística, servicios, planos.
ENABLE_COMMERCIAL_MODULES=false

# Import masivo desde Excel (desde carpeta backend): ver scripts/import_control_inventario_xlsx.py --help
# Ejemplo SQLite local: python scripts/import_control_inventario_xlsx.py --sqlite --dry-run
