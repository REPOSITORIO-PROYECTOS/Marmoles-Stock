# --- Build (Vite) ---
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/app/package*.json ./
RUN npm ci

COPY frontend/app/ ./

# En producción detrás de nginx, el cliente usa mismo origen y /api se proxea (no fijar VITE_API_BASE_URL aquí).
RUN npm run build

# --- Runtime: nginx sirve estáticos y proxea /api al backend (Compose: servicio "backend" en :8000) ---
FROM nginx:1.26-alpine

COPY --from=builder /app/build /usr/share/nginx/html
COPY frontend/app/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chmod -R 755 /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
