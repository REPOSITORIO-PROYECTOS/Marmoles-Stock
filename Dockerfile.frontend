# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/app/package*.json ./

RUN npm ci

# Copiar código fuente
COPY frontend/app/ ./

# Build
RUN npm run build

# Stage 2: Runtime
FROM node:20-alpine

WORKDIR /app

# Instalar servidor HTTP ligero
RUN npm install -g serve

# Copiar build del stage anterior
COPY --from=builder /app/build ./build

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:5120 || exit 1

EXPOSE 5120

# Iniciar con serve
CMD ["serve", "-s", "build", "-l", "5120"]
